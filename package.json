{
  "name": "gadgets-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy",
    "emulators": "firebase emulators:start --only auth,firestore --project gadgets-hub-c4fac",
